<Window x:Class="Recovery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Recovery.Core;assembly=Recovery.Core"
        Title="雨痕数据恢复 1.14.0 · TSK/PhotoRec 只读安全模式" Width="1440" Height="900" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/yuhen-ui-256.png" Width="54" Height="54" Stretch="Uniform" Margin="0,0,13,0"/>
        <TextBlock Text="雨痕数据恢复" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#173A35" BorderBrush="#2C806F" BorderThickness="1" CornerRadius="18" Padding="16,7" VerticalAlignment="Center">
        <TextBlock Text="● 源介质永久只读" Foreground="#79E6CF" FontWeight="SemiBold"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="SourceCombo" MinWidth="500" Height="58" MaxDropDownHeight="420" VerticalAlignment="Center" ToolTip="选择要只读扫描的源介质">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem"><Setter Property="MinHeight" Value="58"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,3"/></Style>
          </ComboBox.ItemContainerStyle>
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid MinWidth="430" ToolTip="{Binding DisplayName}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="#18324A" BorderBrush="#315773" BorderThickness="1" VerticalAlignment="Center">
                  <Path Width="23" Height="23" Stretch="Uniform" Stroke="#66E3CD" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="Data" Value="M4,6 L20,6 20,18 4,18 Z M7,15 L9,15 M16,15 L17,15"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.HardDisk}"><Setter Property="Data" Value="M4,5 L20,5 20,19 4,19 Z M7,15 A3,3 0 1 0 13,15 A3,3 0 1 0 7,15 M16,15 L17,15"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.SolidState}"><Setter Property="Data" Value="M5,5 L19,5 19,19 5,19 Z M8,9 L16,9 M8,12 L16,12 M8,15 L13,15"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.UsbStorage}"><Setter Property="Data" Value="M9,3 L15,3 15,8 17,8 17,20 7,20 7,8 9,8 Z M10,3 L10,6 M14,3 L14,6"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.MemoryCard}"><Setter Property="Data" Value="M7,3 L15,3 19,7 19,21 5,21 5,5 Z M9,4 L9,9 M12,4 L12,9 M15,4 L15,9"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.Raid}"><Setter Property="Data" Value="M4,4 L20,4 20,9 4,9 Z M4,10 L20,10 20,15 4,15 Z M4,16 L20,16 20,21 4,21 Z M17,6.5 L18,6.5 M17,12.5 L18,12.5 M17,18.5 L18,18.5"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.StorageSpace}"><Setter Property="Data" Value="M4,7 C4,4 20,4 20,7 C20,10 4,10 4,7 Z M4,7 L4,17 C4,20 20,20 20,17 L20,7 M4,12 C4,15 20,15 20,12"/></DataTrigger>
                          <DataTrigger Binding="{Binding Category}" Value="{x:Static core:MediaCategory.Image}"><Setter Property="Data" Value="M6,3 L15,3 19,7 19,21 6,21 Z M15,3 L15,7 19,7 M9,16 L12,13 15,16 17,14"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                  <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding MediaTraitsLabel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="刷新磁盘" Click="Refresh_Click"/><Button Content="打开镜像" Click="OpenImage_Click"/><Button Content="创建镜像" Click="CreateImage_Click"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,20,0">
            <TextBlock Text="选择故障场景" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,5"/>
            <UniformGrid Columns="3" Rows="1">
              <RadioButton x:Name="DeletedScenarioCheck" GroupName="RecoveryScenario" IsChecked="True" Checked="Scenario_Checked"
                           Content="误删除文件" Padding="14,10" Margin="0,0,8,0" ToolTip="优先解析当前文件系统元数据，尽量保留原文件名和目录。"/>
              <RadioButton x:Name="FormattedScenarioCheck" GroupName="RecoveryScenario" Checked="Scenario_Checked"
                           Content="快速格式化 / RAW" Padding="14,10" Margin="0,0,8,0" ToolTip="搜索备用结构和旧元数据，并用内容扫描兜底。"/>
              <RadioButton x:Name="LostPartitionScenarioCheck" GroupName="RecoveryScenario" Checked="Scenario_Checked"
                           Content="分区丢失 / 分区表损坏" Padding="14,10" ToolTip="只读搜索候选分区，再从候选范围恢复文件；不会写回分区表。"/>
            </UniformGrid>
            <Border Background="#0D1C31" BorderBrush="#29405E" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock x:Name="ScenarioSummaryText" Text="优先恢复原文件名和目录；需要时可在高级设置中启用内容扫描。" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="PlanStagesText" Text="扫描阶段：识别分区 → 文件系统元数据" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0" VerticalAlignment="Stretch">
            <StackPanel x:Name="ScanControlsPanel" VerticalAlignment="Center">
              <TextBlock Text="扫描控制" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,5"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="ScanButton" Content="开始扫描" Width="112" Height="44" Background="#1B7665" BorderBrush="#35B99E" Click="Scan_Click"/>
                <Button x:Name="PauseButton" Content="暂停" Width="82" Height="44" IsEnabled="False" Click="Pause_Click"/>
                <Button x:Name="CancelButton" Content="停止" Width="82" Height="44" IsEnabled="False" Click="Cancel_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="高级设置（专业扫描选项）" Margin="0,10,0,0" IsExpanded="False">
          <Border Background="#0D1728" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,7,0,0">
            <StackPanel>
              <WrapPanel x:Name="ScanOptionsPanel">
                <CheckBox x:Name="MetadataCheck" Content="文件系统元数据（NTFS/exFAT/FAT32）" IsChecked="True"/>
                <CheckBox x:Name="DeepMetadataCheck" Content="NTFS 深度元数据（旧文件名）"/>
                <CheckBox x:Name="ExFatDeepMetadataCheck" Content="exFAT 深度元数据"/>
                <CheckBox x:Name="FullDiskMetadataCheck" Content="全盘旧 MFT（慢）"/>
                <CheckBox x:Name="CarveCheck" Content="PhotoRec 内容扫描（无原名兜底）" ToolTip="使用开源 PhotoRec 扫描未分配空间或未知文件系统，结果使用临时文件名。"/>
                <CheckBox x:Name="LostPartitionCheck" Content="搜索丢失分区（慢）" ToolTip="只读搜索丢失的 NTFS、exFAT、FAT32 分区，不写回源介质。"/>
              </WrapPanel>
              <WrapPanel Margin="0,3,0,0">
                <TextBlock Text="PhotoRec 可选类别：" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <CheckBox x:Name="PhotoRecMediaCheck" Content="音频 / 视频" ToolTip="额外扫描 MP3、WAV、AVI、MP4/MOV 等；耗时和候选数量会增加。"/>
                <CheckBox x:Name="PhotoRecArchiveCheck" Content="压缩包" ToolTip="额外扫描 RAR、7Z 和 ZIP 容器；ZIP 同时覆盖 DOCX/XLSX/PPTX。"/>
                <TextBlock Text="图片和常见文档默认启用；文本只走元数据恢复，不做无边界雕刻。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Expander>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" ToolTip="按文件名或原路径搜索" TextChanged="FilterText_Changed" Margin="4" Padding="10,8"/>
          <ComboBox Grid.Column="1" x:Name="QualityCombo" SelectionChanged="Filter_Changed" Margin="4">
            <ComboBoxItem Content="全部恢复质量" IsSelected="True" Tag="All"/><ComboBoxItem Content="优秀" Tag="Excellent"/><ComboBoxItem Content="良好" Tag="Good"/><ComboBoxItem Content="部分" Tag="Partial"/><ComboBoxItem Content="较差" Tag="Poor"/><ComboBoxItem Content="已覆盖" Tag="Overwritten"/><ComboBoxItem Content="TRIM/清零" Tag="TrimmedOrZeroed"/>
          </ComboBox>
          <ComboBox Grid.Column="2" x:Name="DiscoveryCombo" SelectionChanged="Filter_Changed" Margin="4">
            <ComboBoxItem Content="全部发现方式" IsSelected="True" Tag="All"/><ComboBoxItem Content="保留原名" Tag="Metadata"/><ComboBoxItem Content="特征扫描" Tag="Raw"/>
          </ComboBox>
          <ComboBox Grid.Column="3" x:Name="IntegrityCombo" SelectionChanged="Filter_Changed" Margin="4">
            <ComboBoxItem Content="全部结构状态" IsSelected="True" Tag="All"/><ComboBoxItem Content="预检通过" Tag="Valid"/><ComboBoxItem Content="画面已抢救" Tag="Salvaged"/><ComboBoxItem Content="结构损坏" Tag="Damaged"/><ComboBoxItem Content="未预检" Tag="NotChecked"/>
          </ComboBox>
          <StackPanel Grid.Column="4" Orientation="Horizontal">
            <CheckBox x:Name="RecoverableOnlyCheck" Content="仅可恢复" Checked="Filter_Changed" Unchecked="Filter_Changed" VerticalAlignment="Center"/>
            <Button x:Name="PreflightButton" Content="预检选中" Click="Preflight_Click" ToolTip="支持注册表内已验证的常见图片、文档、音视频、压缩包和文本格式。"/>
            <Button Content="保存结果" Click="SaveSession_Click"/><Button Content="打开结果" Click="LoadSession_Click"/><Button Content="继续会话" Click="ContinueCheckpoint_Click" ToolTip="打开自动保存的 v3 扫描检查点，验证为同一介质后继续未完成阶段。"/><Button Content="导出清单" Click="ExportCsv_Click"/>
          </StackPanel>
        </Grid>
        <Grid Margin="0,5,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="132"/><ColumnDefinition Width="116"/><ColumnDefinition Width="116"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="扩展名" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6,0,0,1"/><TextBox x:Name="ExtensionBox" ToolTip="多个扩展名可用空格或逗号分隔" TextChanged="FilterText_Changed" Margin="4" Padding="9,7"/></StackPanel>
          <TextBlock Grid.Column="1" Text="修改日期" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
          <DatePicker Grid.Column="2" x:Name="ModifiedFromPicker" SelectedDateChanged="Filter_Changed" Margin="4" ToolTip="起始修改日期"/>
          <TextBlock Grid.Column="3" Text="至" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="3"/>
          <DatePicker Grid.Column="4" x:Name="ModifiedToPicker" SelectedDateChanged="Filter_Changed" Margin="4" ToolTip="结束修改日期"/>
          <StackPanel Grid.Column="5"><TextBlock Text="最小大小" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6,0,0,1"/><TextBox x:Name="MinimumSizeBox" ToolTip="例如 100KB、5MB、1GB" TextChanged="FilterText_Changed" Margin="4" Padding="9,7"/></StackPanel>
          <StackPanel Grid.Column="6"><TextBlock Text="最大大小" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="6,0,0,1"/><TextBox x:Name="MaximumSizeBox" ToolTip="例如 10MB、2GB" TextChanged="FilterText_Changed" Margin="4" Padding="9,7"/></StackPanel>
          <CheckBox Grid.Column="7" x:Name="PreviewableOnlyCheck" Content="可预览" Checked="Filter_Changed" Unchecked="Filter_Changed" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="8" Text="支持 KB / MB / GB / TB" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
          <StackPanel Grid.Column="9" Orientation="Horizontal">
            <Button x:Name="ListViewButton" Content="列表" Tag="List" Click="ResultView_Click" Background="#1B7665"/>
            <Button x:Name="TreeViewButton" Content="目录树" Tag="Tree" Click="ResultView_Click"/>
            <Button x:Name="ThumbnailViewButton" Content="缩略图" Tag="Thumbnail" Click="ResultView_Click"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="文件分类" FontSize="17" FontWeight="SemiBold" Margin="6,4,6,8"/>
          <ListBox Grid.Row="1" x:Name="CategoryList" MaxHeight="172" SelectionChanged="Filter_Changed" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" DisplayMemberPath="DisplayName"/>
          <StackPanel Grid.Row="2" x:Name="PartitionCandidatesPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="候选分区" FontSize="16" FontWeight="SemiBold" Margin="6,0,6,3"/>
            <TextBlock x:Name="PartitionCandidateSummary" Text="等待分区搜索" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="6,0,6,7"/>
            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <ItemsControl x:Name="PartitionCandidateList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#101D31" BorderBrush="#304561" BorderThickness="1" CornerRadius="6" Padding="7" Margin="2,0,2,7">
                        <StackPanel>
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                          <TextBlock Text="{Binding ConfidenceLabel, Mode=OneWay}" Foreground="#79E6CF"/>
                          <TextBlock Text="{Binding FileSystemLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding RangeLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding StructureLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                          <TextBlock Text="{Binding EvidenceLabel, Mode=OneWay}" Foreground="#9FB3D8" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Expander Header="低可信候选（默认不选）" IsExpanded="False" Margin="2,1,2,5">
                  <ItemsControl x:Name="LowConfidencePartitionCandidateList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#251927" BorderBrush="#70435B" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,7">
                          <StackPanel>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FileSystemLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding RangeLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StructureLabel, Mode=OneWay}" Foreground="#F4A6B8" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EvidenceLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Expander>
              </StackPanel>
            </ScrollViewer>
            <Button x:Name="ConfirmPartitionSelectionButton" Content="使用选中范围继续" Click="ConfirmPartitionSelection_Click" Background="#1B7665" BorderBrush="#35B99E" HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="2,7,2,0"/>
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,12,0">
        <Grid>
          <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" AlternationCount="2" SelectionChanged="ResultsGrid_SelectionChanged" PreviewKeyDown="ResultsGrid_PreviewKeyDown" Background="#0E1728" Foreground="{StaticResource TextBrush}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#263653" HeadersVisibility="Column" ColumnHeaderHeight="42" RowHeaderWidth="0" ToolTip="Ctrl+A 全选；单击后按住 Shift 点击可连续选择；按住 Ctrl 点击可增减单项。"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="96" MinWidth="96" MaxWidth="96" CanUserSort="False">
                <DataGridTemplateColumn.HeaderTemplate><DataTemplate><CheckBox Content="全选" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="勾选或取消当前筛选结果中的全部文件" Checked="SelectAllRecovery_Checked" Unchecked="SelectAllRecovery_Unchecked"/></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsMarkedForRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRecover}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="勾选后加入批量恢复；目录节点不可恢复" Click="RecoveryMark_Click">
                      <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                          <Setter Property="Content" Value="选择"/><Setter Property="Foreground" Value="#CBD5E1"/><Setter Property="FontWeight" Value="Normal"/>
                          <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="已选"/><Setter Property="Foreground" Value="#A7F3D0"/><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers>
                        </Style>
                      </CheckBox.Style>
                    </CheckBox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="原路径" Binding="{Binding OriginalPath}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Extension}" Width="65"/><DataGridTextColumn Header="大小" Binding="{Binding Size, StringFormat=N0}" Width="100"/><DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedLabel}" Width="145"/><DataGridTextColumn Header="结构" Binding="{Binding IntegrityLabel}" Width="100"/><DataGridTextColumn Header="质量" Binding="{Binding QualityLabel}" Width="110"/><DataGridTextColumn Header="来源" Binding="{Binding DuplicateRecordCount}" Width="65"/><DataGridTextColumn Header="发现方式" Binding="{Binding DiscoveryLabel}" Width="180"/>
            </DataGrid.Columns>
          </DataGrid>
          <TreeView x:Name="TreeResults" Visibility="Collapsed" Background="#0E1728" Foreground="{StaticResource TextBrush}" BorderThickness="0" SelectedItemChanged="TreeResults_SelectedItemChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <ListBox x:Name="ThumbnailList" Visibility="Collapsed" Background="#0E1728" Foreground="{StaticResource TextBrush}" BorderThickness="0" SelectionMode="Extended" SelectionChanged="ThumbnailList_SelectionChanged" PreviewKeyDown="ThumbnailList_PreviewKeyDown"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Loaded="ThumbnailCard_Loaded" BorderBrush="#29405E" BorderThickness="0,0,0,1" Padding="8" MinHeight="96">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="108" Height="78" Background="#09111F" BorderBrush="#334766" BorderThickness="1">
                      <Grid><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5"/></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,4">
                      <TextBlock Text="{Binding Candidate.OriginalPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"><Run Text="{Binding Candidate.Extension, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Candidate.Size, Mode=OneWay, StringFormat=N0}"/><Run Text=" 字节 · "/><Run Text="{Binding Candidate.QualityLabel, Mode=OneWay}"/></TextBlock>
                      <TextBlock Text="{Binding Candidate.DiscoveryLabel, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding Candidate.IsMarkedForRecovery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Candidate.CanRecover}" Content="恢复" Click="ThumbnailRecoveryMark_Click" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="文件预览" FontSize="18" FontWeight="SemiBold"/>
          <Border Height="190" Margin="0,10,0,8" Background="#0A1120" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"><Grid><Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"/><TextBox x:Name="PreviewTextBox" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#0A1120" Padding="8"/><TextBlock x:Name="PreviewMessage" Text="选择文件后查看信息" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"/></Grid></Border>
          <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="PreviewDetails" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
          <Separator Margin="0,14" Background="{StaticResource BorderBrush}"/><TextBlock Text="恢复输出" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="必须选择与源介质不同的物理磁盘。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/>
          <TextBox x:Name="DestinationBox" Text="C:\RecoveredFiles" Margin="0,0,0,8"/><StackPanel Orientation="Horizontal"><Button Content="选择目录" Click="ChooseDestination_Click"/><Button Content="清除全部选择" Click="ClearRecoveryMarks_Click"/></StackPanel><Button x:Name="RecoverButton" Content="恢复选中文件" Background="#1B7665" BorderBrush="#35B99E" HorizontalAlignment="Stretch" Margin="4,10,4,4" Click="Recover_Click"/><TextBlock Text="Ctrl+A 全选；Shift 连选；Ctrl 增减单项；也可使用复选框。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,2,4,0"/>
          <Separator Margin="0,14" Background="{StaticResource BorderBrush}"/><TextBlock Text="运行日志" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="190" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"/>
        <ProgressBar x:Name="ProgressBar" Height="14" Minimum="0" Maximum="100" Margin="0,8,0,0" Foreground="{StaticResource AccentBrush}" Background="#172238"/>
      </StackPanel>
      <TextBlock Grid.Column="1" x:Name="CountText" Text="0 / 0 个候选文件" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="18,0,0,0"/>
    </Grid>
  </Grid>
</Window>
